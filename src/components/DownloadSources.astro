---
import type { PlatformDownload } from "../data/downloadManifest";
import PrimaryButton from "./PrimaryButton.astro";
import SecondaryButton from "./SecondaryButton.astro";
interface Props { platform: PlatformDownload }
const { platform } = Astro.props;
---
<div class="button-row" role="group" aria-label={`${platform.displayName} 下载来源`}>
  <PrimaryButton href={platform.downloadUrl} external>GitHub</PrimaryButton>
  {platform.cnbDownloadUrl && <SecondaryButton href={platform.cnbDownloadUrl} external>CNB（国内）</SecondaryButton>}
  <slot />
</div>
