---
import {
  downloadStats,
  appDownloadSummary,
  formatDownloadCount,
  formatStatsUpdatedAt,
  type DownloadTotals,
} from "../data/downloadStats";

const { totals, versions, models, snapshots } = downloadStats;
const previous = snapshots.length > 1 ? snapshots.at(-2) : null;
const modelByPlatform = Object.fromEntries(models.map((item) => [item.platform, item.modelDownloads]));
const recentVersions = versions.slice(0, 3);
const olderVersions = versions.slice(3);

const cards: Array<{ key: keyof DownloadTotals; label: string; detail: string }> = [
  { key: "macosInstallerDownloads", label: "macOS 安装包", detail: "历次 DMG 下载" },
  { key: "windowsPackageDownloads", label: "Windows 安装包", detail: "EXE / MSI 下载，含旧版共用文件的更新" },
  { key: "identifiableUpdateDownloads", label: "应用更新包", detail: "可单独识别的 macOS / Windows 更新" },
  {
    key: "modelDownloads",
    label: "本地模型",
    detail: `macOS ${formatDownloadCount(modelByPlatform["macos-arm64"] ?? 0)} · Windows ${formatDownloadCount(modelByPlatform["windows-x64"] ?? 0)}`,
  },
];
---

<details class="download-stats">
  <summary class="download-stats-toggle">
    <span>
      <strong>下载统计</strong>
      <small data-download-summary={appDownloadSummary.metric}
        data-download-source={appDownloadSummary.source}
        data-download-count={appDownloadSummary.count}
        data-stats-updated-at={appDownloadSummary.generatedAt}>
        GitHub 累计下载 <span data-download-count-value>{formatDownloadCount(appDownloadSummary.count)}</span> 次 · 每天 06:00 更新
      </small>
    </span>
    <span class="download-stats-toggle-action" aria-hidden="true">查看</span>
  </summary>

  <div class="download-stats-content">
    <div class="download-stats-heading">
      <div>
        <p class="eyebrow">公开统计</p>
        <h2>下载记录</h2>
        <p>软件包下载次数来自 GitHub Releases，模型单列，不含 CNB 镜像下载，每天 06:00 更新。</p>
      </div>
      <p class="download-stats-updated">
        最近更新
        <time datetime={downloadStats.generatedAt}>{formatStatsUpdatedAt(downloadStats.generatedAt)}</time>
      </p>
    </div>

    <div class="download-stat-grid">
      {cards.map((card) => {
        const delta = previous ? totals[card.key] - previous[card.key] : null;
        return (
          <article class="download-stat-card">
            <span>{card.label}</span>
            <strong>{formatDownloadCount(totals[card.key])}</strong>
            <p>{card.detail}</p>
            {delta !== null && delta > 0 && <small>较上次记录 +{formatDownloadCount(delta)}</small>}
          </article>
        );
      })}
    </div>

    <div class="download-version-heading">
      <div>
        <h3>最近版本</h3>
        <p>只显示最近三个版本，旧版本明细可以继续展开。</p>
      </div>
      <span>{versions.length} 个版本</span>
    </div>

    <div class="download-version-table-wrap" tabindex="0" role="region" aria-label="最近版本累计下载次数">
      <table class="download-version-table">
        <caption class="sr-only">最近版本累计下载次数</caption>
        <thead>
          <tr><th scope="col">版本</th><th scope="col">macOS</th><th scope="col">Windows</th><th scope="col">更新包</th><th scope="col">合计</th></tr>
        </thead>
        <tbody>
          {recentVersions.map((version) => (
            <tr>
              <th scope="row">v{version.version}</th>
              <td>{formatDownloadCount(version.macosInstallerDownloads)}</td>
              <td>{formatDownloadCount(version.windowsPackageDownloads)}</td>
              <td>{formatDownloadCount(version.identifiableUpdateDownloads)}</td>
              <td><strong>{formatDownloadCount(version.appPackageDownloads)}</strong></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    {olderVersions.length > 0 && <details class="download-version-history">
      <summary>查看全部版本（{olderVersions.length} 个更早版本）</summary>
      <div class="download-version-table-wrap" tabindex="0" role="region" aria-label="更早版本累计下载次数">
        <table class="download-version-table">
          <caption class="sr-only">更早版本累计下载次数</caption>
          <thead>
            <tr><th scope="col">版本</th><th scope="col">macOS</th><th scope="col">Windows</th><th scope="col">更新包</th><th scope="col">合计</th></tr>
          </thead>
          <tbody>
            {olderVersions.map((version) => (
              <tr>
                <th scope="row">v{version.version}</th>
                <td>{formatDownloadCount(version.macosInstallerDownloads)}</td>
                <td>{formatDownloadCount(version.windowsPackageDownloads)}</td>
                <td>{formatDownloadCount(version.identifiableUpdateDownloads)}</td>
                <td><strong>{formatDownloadCount(version.appPackageDownloads)}</strong></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>}

    <details class="download-stats-notes">
      <summary>统计口径</summary>
      <div>
        <p>这里统计的是文件下载次数，不是独立用户数或成功安装数，重复下载也会计入。</p>
        <p>首页与本页主数字均为软件安装包和更新包的合计，不含独立模型、更新清单、签名及 CNB 镜像。旧版 Windows 安装和更新共用的 EXE 无法拆开，新版独立更新包单列。</p>
        <p>按当前公开 Release 文件的计数汇总；删除或重传文件可能使平台计数回退，历史快照之间的差值不等于精确新增用户数。</p>
        <p><a href={downloadStats.source.releasesUrl} target="_blank" rel="noreferrer">查看公开 Release 文件</a></p>
      </div>
    </details>
  </div>
</details>
