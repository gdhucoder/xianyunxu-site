---
interface Props { question: string; open?: boolean; id?: string }
const { question, open = false, id } = Astro.props;
---
<details id={id} class="faq-item" open={open}>
  <summary><span>{question}</span><span class="faq-marker" aria-hidden="true"></span></summary>
  <div class="faq-answer"><slot /></div>
</details>
