---
import Logo from "./Logo.astro";
import { appDownloadSummary, formatDownloadCount } from "../data/downloadStats";
import { sitePath } from "../lib/urls";

interface Props {
  showDownloadTotal?: boolean;
}

const { showDownloadTotal = false } = Astro.props;
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div class="footer-brand">
      <div class="brand-lockup footer-lockup"><Logo size={34} /><span class="brand-name">纤云叙</span></div>
      <p>写邮件、回消息、记想法，开口说就行。</p>
      <p class="fine-print">macOS Apple Silicon 与 Windows x64 Beta 可以下载。</p>
      {showDownloadTotal && <p class="footer-download-total"
        data-download-summary={appDownloadSummary.metric}
        data-download-source={appDownloadSummary.source}
        data-download-count={appDownloadSummary.count}
        data-stats-updated-at={appDownloadSummary.generatedAt}
        title="软件安装包与更新包的文件下载次数，不含独立模型和 CNB 镜像下载，不是用户数">
        GitHub 累计下载 <strong data-download-count-value>{formatDownloadCount(appDownloadSummary.count)}</strong> 次
      </p>}
    </div>
    <div>
      <h2>产品</h2>
      <a href={sitePath("/download/")}>下载</a>
      <a href={sitePath("/install/")}>安装说明</a>
      <a href={sitePath("/changelog/")}>更新日志</a>
    </div>
    <div>
      <h2>帮助</h2>
      <a href={sitePath("/privacy/")}>隐私说明</a>
      <a href={sitePath("/faq/")}>常见问题</a>
      <a href="https://github.com/gdhucoder/xianyun-releases" target="_blank" rel="noopener noreferrer">GitHub Releases</a>
    </div>
  </div>
  <div class="shell footer-bottom">
    <span>© 2026 纤云叙</span>
    <span>这里不放广告，也不做营销追踪。</span>
  </div>
</footer>
