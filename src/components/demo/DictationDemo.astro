---
import config from '../../data/dictation-demo.json';
import Logo from '../Logo.astro';
import './dictation-demo.css';
---
<xianyun-dictation-demo class="xy-demo" data-phase="prompt" data-playback="idle" aria-label="跨应用语音听写演示">
  <div class="xy-demo-heading">
    <div><span class="xy-demo-kicker">{config.ui.eyebrow}</span><h2 data-scene-title>{config.stages[0]!.title}</h2><p data-scene-description>{config.stages[0]!.description}</p></div>
    <span class="xy-demo-example"><span aria-hidden="true"></span>演示示例</span>
  </div>

  <div class="xy-demo-scene">
    <div class="xy-chat" aria-label="简化聊天窗口，非真实聊天应用">
      <div class="xy-chat-toolbar"><span class="xy-window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>{config.ui.windowTitle}</span><svg viewBox="0 0 20 20" aria-hidden="true"><rect x="4" y="4" width="12" height="12" rx="3"/><path d="M4 8h12"/></svg></div>
      <div class="xy-chat-main">
        <aside class="xy-chat-rail" aria-label="预设会话列表，非交互示意">
          <div class="xy-chat-rail-heading"><strong>{config.chat.sectionTitle}</strong><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 4v12M4 10h12"/></svg></div>
          <div class="xy-chat-search" aria-hidden="true"><svg viewBox="0 0 20 20"><circle cx="8.5" cy="8.5" r="5"/><path d="m12.5 12.5 4 4"/></svg><span>{config.chat.searchPlaceholder}</span></div>
          <div class="xy-chat-contacts">{config.chat.conversations.map((item) => <div class:list={['xy-chat-contact', { 'is-active': item.active }]}><span class:list={['xy-list-avatar', `tone-${item.tone}`]} aria-hidden="true">{item.initial}</span><span class="xy-list-copy"><strong>{item.name}</strong><small>{item.preview}</small></span><time>{item.time}</time></div>)}</div>
        </aside>
        <div class="xy-chat-conversation">
          <header class="xy-contact-header"><span class="xy-contact-avatar" aria-hidden="true">{config.contact.initial}</span><span><strong>{config.contact.name}</strong><small>{config.contact.context}</small></span><span class="xy-chat-more" aria-hidden="true">···</span></header>
          <div class="xy-chat-thread" data-chat-context>
            <p class="xy-chat-date">{config.chat.contextTime}</p>
            <div class="xy-chat-incoming"><span class="xy-message-avatar" aria-hidden="true">{config.contact.initial}</span><p>{config.chat.contextMessage}</p></div>
          </div>
          <div class="xy-composer">
            <div class="xy-composer-tools" aria-hidden="true"><svg viewBox="0 0 20 20"><circle cx="10" cy="10" r="7"/><path d="M7 12q3 3 6 0M7 7.5h.1M13 7.5h.1"/></svg><svg viewBox="0 0 20 20"><path d="M3 6V4h5l2 2h7v10H3z"/></svg><svg viewBox="0 0 20 20"><rect x="3" y="3" width="14" height="14" rx="2"/><path d="m4 14 4-4 3 3 3-5 3 5M7 6h.1"/></svg></div>
            <div class="xy-composer-input"><textarea data-message readonly tabindex="-1" aria-label="聊天输入框，只读演示" placeholder={config.ui.composerPlaceholder} rows="3"></textarea><span class="xy-composer-caret" aria-hidden="true"></span></div>
            <div class="xy-composer-footer"><span><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7"/><path d="M7 12q3 3 6 0M7 7.5h.1M13 7.5h.1"/></svg><small>{config.ui.sendingHint}</small></span><button type="button" disabled aria-label="发送已禁用，演示不会发送消息">{config.ui.sendButton}<svg viewBox="0 0 20 20" aria-hidden="true"><path d="m4 10 12-6-4 12-2-6zM10 10l6-6"/></svg></button></div>
          </div>
        </div>
      </div>
    </div>

    <div class="xy-overlay-area">
      <div class="xy-overlay-brand"><Logo size={22} /><strong>纤云叙</strong><span>{config.ui.overlayNote}</span></div>
      <div class="xy-shortcut"><kbd>{config.shortcut.label}</kbd><span>{config.ui.shortcutHint}</span></div>
      <div class="xy-capsule" role="img" aria-label="纤云叙录音条演示">
        <span class="xy-capsule-wave" aria-hidden="true">{config.waveform.weights.map(() => <i data-wave-bar></i>)}</span>
        <span class="xy-capsule-dots" aria-hidden="true"><i data-process-dot></i><i data-process-dot></i><i data-process-dot></i></span>
        <span class="xy-capsule-record-label">{config.ui.recordingLabel}</span><span class="xy-capsule-process-label">{config.ui.processingLabel}</span><time data-record-time>0:00</time>
      </div>
      <div class="xy-filled"><span>{config.ui.filledLabel}</span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 10 3 3 7-7"/></svg></div>
    </div>
  </div>

  <div class="xy-spoken"><span class="xy-spoken-label" data-caption-label>{config.ui.captionIdle}</span><p data-subtitle>{config.ui.initialCaption}</p></div>
  <div class="xy-demo-controls">
    <div class="xy-demo-buttons"><button class="xy-play" type="button" data-toggle data-icon="play"><svg class="xy-icon-play" viewBox="0 0 20 20" aria-hidden="true"><path d="m7 4 9 6-9 6z"/></svg><svg class="xy-icon-pause" viewBox="0 0 20 20" aria-hidden="true"><path d="M7 5v10M13 5v10"/></svg><svg class="xy-icon-replay" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 7a6 6 0 1 1 0 7M5 3v5h5"/></svg><span data-toggle-label>{config.ui.play}</span></button><button class="xy-replay" type="button" data-replay disabled><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 7a6 6 0 1 1 0 7M5 3v5h5"/></svg>{config.ui.restart}</button></div>
    <div class="xy-demo-progress"><progress data-progress max={config.durationMs} value="0" aria-label="演示进度"></progress><span data-clock>0:00 / 0:21</span></div>
  </div>
  <ol class="xy-demo-steps" aria-label="演示步骤">{['准备说话', '语音听写', '文字整理', '填入对话'].map((label, index) => <li data-step data-status={index === 0 ? 'current' : 'next'} aria-current={index === 0 ? 'step' : undefined}><span>{String(index + 1).padStart(2, '0')}</span>{label}</li>)}</ol>
  <div class="xy-demo-bottom"><p class="xy-demo-feedback" data-feedback>{config.ui.feedbackIdle}</p><label class="xy-motion-option"><input type="checkbox" data-reduce-motion />{config.ui.reducedMotionLabel}</label></div>
  <p class="xy-reduced-note" data-reduced-note hidden>{config.ui.reducedMotionNote}</p>
  <p class="sr-only" data-announcement aria-live="polite" aria-atomic="true"></p>
  <noscript><p class="xy-demo-noscript">请开启 JavaScript 播放。示例整理结果：{config.result}（不会发送消息）</p></noscript>
</xianyun-dictation-demo>

<script>
  import { mountDictationDemo } from '../../lib/dictation-demo-controller';
  class XianyunDictationDemo extends HTMLElement {
    private dispose: (() => void) | undefined;
    connectedCallback() { this.dispose ??= mountDictationDemo(this); }
    disconnectedCallback() { this.dispose?.(); this.dispose = undefined; }
  }
  if (!customElements.get('xianyun-dictation-demo')) customElements.define('xianyun-dictation-demo', XianyunDictationDemo);
</script>
