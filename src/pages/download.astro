---
import BaseLayout from "../layouts/BaseLayout.astro";
import DownloadCard from "../components/DownloadCard.astro";
import DownloadStats from "../components/DownloadStats.astro";
import SecondaryButton from "../components/SecondaryButton.astro";
import { downloadManifest, formatPublishedDate, bundledModelInstallers } from "../data/downloadManifest";
import { sitePath } from "../lib/urls";
const macos = downloadManifest.platforms["macos-arm64"];
const windows = downloadManifest.platforms["windows-x64"];
const hasCnbMirrors = Boolean(macos.cnbDownloadUrl && windows.cnbDownloadUrl);
---
<BaseLayout title="下载" description="下载纤云叙 macOS 与 Windows 安装包，查看安装说明与文件校验值。">
  <header class="page-hero download-hero"><div class="shell">
    <p class="eyebrow">下载</p>
    <h1>选好系统，就可以下载了。</h1>
    <p>{hasCnbMirrors ? "两个渠道提供同一份安装包，任选其一。" : "选择对应系统，下载安装包。"}</p>
    <p class="release-summary" data-release-summary aria-label="当前发布信息">v{downloadManifest.version}{downloadManifest.channel === "beta" ? " Beta" : ""} · {bundledModelInstallers ? "已内置本地模型" : "识别模型需另行安装"}</p>
  </div></header>
  <section class="section download-content"><div class="shell">
    <div class="download-grid">
      <DownloadCard platformId="macos-arm64" platform={macos} version={downloadManifest.version} channel={downloadManifest.channel} />
      <DownloadCard platformId="windows-x64" platform={windows} version={downloadManifest.version} channel={downloadManifest.channel} />
    </div>
    <p class="model-note">{bundledModelInstallers ? "首次安装无需另下模型；后续应用内更新复用已有模型。" : "首次使用请在应用设置中安装或导入识别模型。"}AI 文字整理为可选项。</p>
    <details class="install-details" data-install-checks>
      <summary>安装与校验说明<span aria-hidden="true">＋</span></summary>
      <div class="install-details-body">
        <div class="grid-2">
          <div>
            <h2>系统与安装</h2>
            <ul class="install-notes">
              <li>macOS：{macos.minimumOsVersion}。</li>
              <li>Windows：{windows.minimumOsVersion}。</li>
              {macos.signingStatus === "self-signed-not-notarized" && <li>Mac 安装包未经 Apple 公证，安装时可能被系统拦截。</li>}
              {windows.signingStatus === "unsigned" && <li>Windows 安装包未配置代码签名，可能出现安全提示。</li>}
            </ul>
            <p>干净 Mac 实机验收尚未完成，不承诺固定首次出字时间。</p>
          </div>
          <div>
            <h2>模型与更新</h2>
            <p>{bundledModelInstallers ? "完整包在本机校验并导入模型，首次加载仍需等待。轻量更新不带模型，保留已有词库、历史、录音与设置；模型缺失或损坏时需修复，不会自动改用在线识别。" : "在“设置 → 本地模型”安装或导入模型；已有有效模型不需要重复下载。"}</p>
            <div class="button-row detail-links">
              <SecondaryButton href={sitePath("/install/")}>安装步骤</SecondaryButton>
              <SecondaryButton href={sitePath("/faq/#local-model")}>模型说明</SecondaryButton>
            </div>
          </div>
        </div>
        <div class="file-checks">
          <h2>文件校验</h2>
          <p>下载后可对照文件名和 SHA-256，确认文件完整。</p>
          <div class="grid-2">
            <div><h3>macOS</h3><dl class="checksum"><dt>文件名</dt><dd>{macos.fileName}</dd><dt>SHA-256</dt><dd>{macos.sha256}</dd></dl></div>
            <div><h3>Windows</h3><dl class="checksum"><dt>文件名</dt><dd>{windows.fileName}</dd><dt>SHA-256</dt><dd>{windows.sha256}</dd></dl></div>
          </div>
        </div>
        <p class="release-detail">{formatPublishedDate(downloadManifest.publishedAt)}发布 · <a href={downloadManifest.releasePageUrl} target="_blank" rel="noopener noreferrer">版本更新说明</a></p>
      </div>
    </details>
  </div></section>
  <section class="section-compact section-tinted"><div class="shell">
    <DownloadStats />
  </div></section>
</BaseLayout>

<style>
  .download-hero { padding-bottom: 0; }
  .download-hero .release-summary { margin-top: var(--space-5); color: var(--brand-primary); font-size: 0.92rem; font-weight: 650; }
  .download-content { padding-top: var(--space-6); }
  .model-note { margin-top: var(--space-5); color: var(--text-secondary); font-size: 0.9rem; }
  .install-details { margin-top: var(--space-6); border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--surface); }
  .install-details summary { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); min-height: 3.75rem; padding: var(--space-4) var(--space-5); cursor: pointer; list-style: none; font-weight: 650; }
  .install-details summary::-webkit-details-marker { display: none; }
  .install-details summary span { color: var(--text-muted); font-size: 1.2rem; font-weight: 400; }
  .install-details[open] summary span { transform: rotate(45deg); }
  .install-details-body { padding: 0 var(--space-5) var(--space-5); color: var(--text-secondary); font-size: 0.9rem; }
  .install-details h2 { margin-bottom: var(--space-3); font-size: 1.05rem; }
  .install-details h3 { margin-block: var(--space-4) var(--space-3); font-size: 0.95rem; }
  .install-notes { margin: 0 0 var(--space-3); padding-left: 1.15rem; }
  .install-notes li + li { margin-top: var(--space-2); }
  .detail-links { margin-top: var(--space-4); }
  .file-checks { margin-top: var(--space-5); padding-top: var(--space-5); border-top: 1px solid var(--border); }
  .checksum dt:not(:first-child) { margin-top: var(--space-3); }
  .release-detail { margin-top: var(--space-5); color: var(--text-muted); font-size: 0.8rem; }
</style>
