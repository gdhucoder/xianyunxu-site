---
import BaseLayout from "../layouts/BaseLayout.astro";
import DownloadCard from "../components/DownloadCard.astro";
import DownloadStats from "../components/DownloadStats.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SecondaryButton from "../components/SecondaryButton.astro";
import PublicPreviewNotice from "../components/PublicPreviewNotice.astro";
import { downloadManifest, formatPublishedDate, bundledModelInstallers } from "../data/downloadManifest";
import { sitePath } from "../lib/urls";
const macos = downloadManifest.platforms["macos-arm64"];
const windows = downloadManifest.platforms["windows-x64"];
---
<BaseLayout title="下载" description="下载纤云叙 macOS Apple Silicon 与 Windows x64 Beta，查看版本、文件大小和安装包校验值。">
  <header class="page-hero"><div class="shell"><p class="eyebrow">下载</p><h1>选好系统，就可以下载了。</h1><p>Mac 和 Windows 目前都有 Beta 版本。这里的按钮会直接带你到公开的 GitHub Releases。</p></div></header>
  <section class="section-compact"><div class="shell">
    <PublicPreviewNotice />
    <div class="metadata-strip" aria-label="当前发布信息">
      <span>Beta 版本</span><span>v{downloadManifest.version}</span><span>{formatPublishedDate(downloadManifest.publishedAt)}发布</span><span>版本信息来自 GitHub Releases</span>
    </div>
  </div></section>
  <section class="section"><div class="shell">
    <div class="download-grid">
      <DownloadCard platformId="macos-arm64" platform={macos} version={downloadManifest.version} channel={downloadManifest.channel} />
      <DownloadCard platformId="windows-x64" platform={windows} version={downloadManifest.version} channel={downloadManifest.channel} />
    </div>
  </div></section>
  <section class="section"><div class="shell">
    <SectionHeading eyebrow="文件校验" title="想确认文件没下错，可以对照这里" description="文件名、大小和 SHA-256 都来自对应的 GitHub Release，可以用来检查下载是否完整。" />
    <div class="grid-2">
      <div><h3 style="margin-bottom: var(--space-3)">macOS Apple Silicon</h3><dl class="checksum"><dt>文件名</dt><dd>{macos.fileName}</dd><dt style="margin-top: var(--space-3)">SHA-256</dt><dd>{macos.sha256}</dd></dl></div>
      <div><h3 style="margin-bottom: var(--space-3)">Windows x64</h3><dl class="checksum"><dt>文件名</dt><dd>{windows.fileName}</dd><dt style="margin-top: var(--space-3)">SHA-256</dt><dd>{windows.sha256}</dd></dl></div>
    </div>
    <div style="margin-top: var(--space-5)"><SecondaryButton href={sitePath("/install/")}>查看对应平台的安装步骤</SecondaryButton></div>
  </div></section>
  <section class="section section-tinted"><div class="shell grid-2">
    <div>
      <SectionHeading eyebrow="当前公开版" title={bundledModelInstallers ? '完整安装包已包含识别模型' : '旧版模型安装方式保持不变'} description="请先核对下载版本；安装包与应用内更新包用途不同。" />
      <p class="prose">{bundledModelInstallers ? '首次安装请使用本页完整包，模型会在本机校验并导入，不要求另行下载。更新时使用应用内轻量包，复用已有有效模型；模型缺失或损坏时需要修复。' : '当前公开旧版在“设置 → 本地模型”安装或导入模型。模型压缩包约 155 MiB，已有有效模型不需要重复下载。'}本地识别不要求先配置大语言模型。</p>
    </div>
    <div class="button-row">
      <SecondaryButton href={sitePath("/faq/#local-model")}>查看模型说明</SecondaryButton>
      <SecondaryButton href={downloadManifest.releasePageUrl} external>查看 v{downloadManifest.version} Release Notes</SecondaryButton>
    </div>
  </div></section>
  <section class="section"><div class="shell">
    <SectionHeading eyebrow="安装与更新" title="新安装用完整包，更新复用已有模型" description="0.1.19 起，完整包内置固定的本地模型；在线文字整理是可选项，不是首次试录的前置条件。" />
    <div class="grid-2">
      <article class="feature-card">
        <span class="eyebrow">首次安装</span>
        <h2>完整包 · 模型随包提供</h2>
        <p>从安装包本地校验并导入识别模型，不要求打开后再下载一次。首次仍有校验和加载等待，不承诺零等待或固定出字秒数。</p>
      </article>
      <article class="feature-card">
        <span class="eyebrow">后续更新</span>
        <h2>轻量包 · 保留已有模型</h2>
        <p>复用已经安装且校验有效的模型，保留原有词库、历史、录音与设置。缺失或损坏时明确提示修复，不静默改用在线识别。</p>
      </article>
    </div>
    <p class="prose" style="margin-top: var(--space-5)">{bundledModelInstallers ? '请使用上方当前版本下载链接。' : '当前新版完整包尚未公开，请勿把旧版下载当成内置模型包。'}Mac 未经 Apple 公证，Windows 安装包未配置代码签名；系统安全策略可能阻止安装。干净 Mac 实机验收尚未完成，自动测试不等于全部硬件与系统验收。</p>
  </div></section>
  <section class="section-compact"><div class="shell cta-band"><div><h2>第一次装？先看两分钟说明</h2><p>Mac 和 Windows 的步骤不太一样，照着对应页面操作会省事很多。</p></div><SecondaryButton href={sitePath("/install/")}>打开安装说明</SecondaryButton></div></section>
  <section class="section section-tinted"><div class="shell">
    <DownloadStats />
  </div></section>
</BaseLayout>
