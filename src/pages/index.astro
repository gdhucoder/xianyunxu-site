---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import WorkflowSteps from "../components/WorkflowSteps.astro";
import FeatureCard from "../components/FeatureCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ScreenshotFrame from "../components/ScreenshotFrame.astro";
import PrivacyPathCard from "../components/PrivacyPathCard.astro";
import PublicPreviewNotice from "../components/PublicPreviewNotice.astro";
import FAQItem from "../components/FAQItem.astro";
import PrimaryButton from "../components/PrimaryButton.astro";
import SecondaryButton from "../components/SecondaryButton.astro";
import PlatformBadge from "../components/PlatformBadge.astro";
import { downloadManifest, bundledModelInstallers } from "../data/downloadManifest";
import { downloadStats, formatDownloadCount } from "../data/downloadStats";
import { sitePath } from "../lib/urls";
const macos = downloadManifest.platforms["macos-arm64"];
const windows = downloadManifest.platforms["windows-x64"];
const totalDownloads = downloadStats.totals.appPackageDownloads + downloadStats.totals.modelDownloads;
---
<BaseLayout footerDownloadTotal={formatDownloadCount(totalDownloads)}>
  <Hero macos={macos} windows={windows} />
  <section class="section-compact"><div class="shell"><PublicPreviewNotice /></div></section>
  <section class="section-compact" aria-labelledby="workflow-title"><div class="shell">
    <SectionHeading eyebrow="日常输入" title="说完，文字回到你手边" description="用系统麦克风开始和停止录音。识别在本机完成，不要求先配置在线服务。自动写入需要相应系统权限，不可用时按提示复制。" />
    <h2 id="workflow-title" class="visually-hidden">语音输入流程</h2><WorkflowSteps />
  </div></section>
  <section class="section section-tinted" aria-labelledby="values-title"><div class="shell">
    <SectionHeading eyebrow="只保留必要的步骤" title="识别快、识别准、好用" description="这是改进方向，不是对每句话的准确率或速度承诺。先让第一次输入简单，再把常用操作做顺手。" />
    <h2 id="values-title" class="visually-hidden">新版的三个改进方向</h2>
    <div class="grid-3">
      <FeatureCard index="01" title="先说一句，不先填配置">0.1.19 完整包已内置识别模型，首次在本机校验并导入；有效模型在后续更新中继续复用。</FeatureCard>
      <FeatureCard index="02" title="常用写法，自己掌握">只填正确写法就能加词；明确的错写映射需确认适用范围，候选不会自动当成正确答案。</FeatureCard>
      <FeatureCard index="03" title="文字整理，按需开启">原话直出、日常聊天、AI 需求、书面表达四种方式。初次试录不调用整理模型，也不用填写密钥。</FeatureCard>
    </div>
  </div></section>
  <section class="section" id="public-preview" aria-labelledby="screenshots-title"><div class="shell">
    <SectionHeading eyebrow="新版界面预览" title="少一点设置，多一点开始" description="以下图片由当前应用界面组件在隔离环境中渲染。文字、词条和统计均为合成示例；不代表当前公开安装包或干净账户验收已完成。" />
    <h2 id="screenshots-title" class="visually-hidden">新版公开版界面</h2>
    <div class="screenshot-featured"><ScreenshotFrame preview title="首页：统计与最近输入" description="看看输入字数、速度、估算节省时间和使用应用数。最近五条文字直接展开，不用先跳到历史页。估算不等于实测效率。" imageBase="preview-home-macos" alt="新版首页预览，显示四项合成统计和五条示例输入历史" width={1680} height={1200} /></div>
    <div class="grid-2">
      <ScreenshotFrame preview title="首次使用：先试说一句" description="新版完整包内置模型，准备好后允许麦克风并试录；看到文字后即可开始使用。辅助功能可稍后设置。" imageBase="preview-first-use-macos" alt="新版两步引导的试录页预览，本地模型已准备好，不要求配置在线服务" width={1680} height={1200} />
      <ScreenshotFrame preview title="模型准备好，就够了" description="平时只显示是否已准备好，模型名称、参数和维护操作收在管理入口。更新不要求重复下载有效模型。" imageBase="preview-model-ready-macos" alt="新版模型设置预览，显示已准备好和管理模型入口" width={1680} height={1200} />
    </div>
    <div class="screenshot-featured"><ScreenshotFrame preview title="个人词典：加词与替换分开" description="正确写法是一格录入，明确替换需看清词对和范围。学习建议等待你确认，不承诺添加后下一次一定识别正确。" imageBase="preview-dictionary-macos" alt="新版个人词典预览，包含紧凑的合成词条、范围选择和快速录入入口" width={1680} height={1200} /></div>
    <div class="screenshot-featured"><ScreenshotFrame preview title="四种方式，整理到刚刚好" description="默认关闭 AI 整理。可选原话直出、日常聊天、AI 需求或书面表达；macOS 可手动绑定应用，浏览器绑定作用于整个浏览器。" imageBase="preview-cleanup-macos" alt="新版文字整理设置预览，显示关闭的 AI 总开关与四种整理方式" width={1680} height={1268} /></div>
  </div></section>
  <section class="section section-tinted" aria-labelledby="paths-title"><div class="shell">
    <SectionHeading eyebrow="数据去向" title="本地识别是默认，云端整理是选择" description="本地语音识别与在线文字整理是两件事。新版不提供在线语音识别入口；只有主动配置并开启在线整理，文字才会发送给该服务。" />
    <h2 id="paths-title" class="visually-hidden">新版数据处理路径</h2>
    <div class="grid-2">
      <PrivacyPathCard title="原话直出 · 不调用整理模型" path="语音 → 本地识别 → 基础处理与词典 → 写入或复制" tone="local">不是未经处理的逐字转写。准备好本地模型后，这条识别路径不需要在线模型服务。</PrivacyPathCard>
      <PrivacyPathCard title="可选 AI 文字整理" path="本地识别 → 按设置整理文字 → 写入或复制" tone="mixed">如果选择在线服务，转写全文及相关词典上下文可能发送给它。关闭总开关或选原话直出，不发起这一步模型请求。</PrivacyPathCard>
    </div>
    <div style="margin-top: var(--space-5)"><SecondaryButton href={sitePath("/privacy/")}>查看数据与录音保存说明</SecondaryButton></div>
  </div></section>
  <section class="section" aria-labelledby="platforms-title"><div class="shell grid-2">
    <div><SectionHeading eyebrow="平台与发布" title="按实际版本下载" description="目前公开提供 macOS Apple Silicon 和 Windows x64 Beta。这里的新版预览来自 Mac 界面；不代表 Windows 新版或干净机器已经完成验收。" /><h2 id="platforms-title" class="visually-hidden">平台发布状态</h2>
      <div class="hero-badges"><PlatformBadge>macOS Apple Silicon · Beta</PlatformBadge><PlatformBadge>Windows x64 · Beta</PlatformBadge><PlatformBadge>Intel Mac · 暂不支持</PlatformBadge></div></div>
    <div class="cta-band"><div><h2>先看版本，再下载</h2><p>{bundledModelInstallers ? '官网提供含模型的完整包；已有用户可在应用内使用轻量更新。安装前请核对签名限制、版本和校验值。' : '新版完整包尚未公开。当前下载链接、版本和校验值保持原样。'}</p></div><PrimaryButton href={sitePath("/download/")}>下载当前公开版</PrimaryButton></div>
  </div></section>
  <section class="section section-tinted" aria-labelledby="faq-title"><div class="shell">
    <SectionHeading eyebrow="常见问题" title="开始之前，先说清楚" /><h2 id="faq-title" class="visually-hidden">常见问题</h2>
    <div class="faq-list">
      <FAQItem question="第一次使用必须配置大语言模型吗？" open>不需要。新版试录只用本地识别；在线文字整理默认关闭，以后到设置里主动配置即可。</FAQItem>
      <FAQItem question="安装后还要下载识别模型吗？">{bundledModelInstallers ? '完整安装包已内置模型，首次在本机校验并导入。轻量更新不带模型，复用有效的已安装模型；缺失或损坏时需要修复。' : '新版完整包准备内置模型并自动导入，轻量更新复用已有模型；当前公开旧版仍按设置里的模型安装步骤使用。'}干净 Mac 断网实测尚未完成，不承诺固定首用耗时。</FAQItem>
      <FAQItem question="录音会自动保存吗？">0.1.19 新安装默认在本机保存文本和录音、永久保留，可在“隐私与数据”关闭或调整。升级保留原设置；已导出的副本不随历史删除而清理。</FAQItem>
      <FAQItem question="添加词条就一定能识别对吗？">不能保证。加词用于转写后的候选、纠正和保护，不是已验证的 ASR 热词。明确的替换映射与只填正确写法是两种不同操作。</FAQItem>
      <FAQItem question="需要专用硬件吗？">不需要。公开版使用系统麦克风与现有桌面快捷键，不提供专用蓝牙设备入口。</FAQItem>
    </div><div style="margin-top: var(--space-5)"><SecondaryButton href={sitePath("/faq/")}>查看全部问题</SecondaryButton></div>
  </div></section>
</BaseLayout>
