---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DictationDemo from '../../components/demo/DictationDemo.astro';
import { sitePath } from '../../lib/urls';
import config from '../../data/dictation-demo.json';
---
<BaseLayout title="跨应用语音听写演示预览" description="纤云叙产品演示动画的独立预览，全部内容为预设示例，不开启麦克风，也不调用识别或整理服务。" noindex>
  <div class="demo-preview-shell">
    <div class="demo-preview-top"><a href={sitePath('/')}>← 返回官网</a><span>独立对照预览 · 与首页同款</span></div>
    <header class="demo-preview-intro"><p class="eyebrow">跨应用语音听写</p><h1>把想法，<em>说进对话里。</em></h1><p>不用切换输入方式。说出想法，让文字回到正在使用的应用。</p></header>
    <DictationDemo />
    <aside class="demo-preview-note" aria-label="演示说明"><p><strong>这是演示示例，不是真实识别。</strong>所有字幕与结果均为预设，不申请麦克风权限，不调用 ASR 或大模型，不会发送消息。</p><p>示例包含可选的 AI 文字整理。日常使用可关闭整理，直接保留识别后的文字。{config.shortcut.hint}</p></aside>
  </div>
</BaseLayout>
<style>
  .demo-preview-shell { width: min(calc(100% - 40px), 1040px); margin: 0 auto; padding: 27px 0 70px; }
  .demo-preview-top { display: flex; justify-content: space-between; gap: 14px; align-items: center; font-size: 11px; color: var(--text-muted); }
  .demo-preview-top a { color: var(--text-secondary); text-decoration: none; }
  .demo-preview-intro { padding: 40px 0 42px; }
  .demo-preview-intro .eyebrow { font-size: 11px; letter-spacing: .16em; }
  .demo-preview-intro h1 { font-size: clamp(32px, 5.3vw, 48px); line-height: 1.25; letter-spacing: -.04em; }
  .demo-preview-intro em { color: var(--brand-primary); font-style: normal; }
  .demo-preview-intro > p:last-child { margin-top: 13px; color: var(--text-secondary); font-size: 14px; }
  .demo-preview-note { margin-top: 30px; padding-top: 20px; border-top: 1px solid var(--border); color: var(--text-muted); font-size: 11px; line-height: 1.9; }
  .demo-preview-note strong { font-weight: 600; color: var(--text-secondary); }
  .demo-preview-note p + p { margin-top: 5px; }
  @media (max-width: 600px) {
    .demo-preview-shell { width: calc(100% - 32px); padding-top: 20px; }
    .demo-preview-top { align-items: flex-start; font-size: 10px; }
    .demo-preview-intro { padding: 33px 0 31px; }
    .demo-preview-intro h1 { font-size: 32px; }
    .demo-preview-intro > p:last-child { font-size: 12px; }
  }
</style>
